{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "enum": [
        "fr",
        "en",
        "ru"
      ]
    },
    "translationKey": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "datePublished": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "type": "string"
    },
    "dateUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverImage": {
      "type": "string"
    },
    "youtubeUrl": {
      "type": "string",
      "format": "uri"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "readingTime": {
      "type": "number"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "slug",
    "locale",
    "translationKey",
    "excerpt",
    "datePublished",
    "category"
  ]
}