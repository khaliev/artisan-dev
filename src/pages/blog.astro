---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Blog / Journal" description="Articles et notes de réflexions sur le développement web et le numérique.">
  <div class="container">
    <header class="page-header">
      <h1>Blog / Journal</h1>
      <p class="subtitle">Articles, réflexions et notes de développement.</p>
    </header>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }
  h1 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-2);
  }
  .subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
</style>
