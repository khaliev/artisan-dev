---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects', ({ data }) => data.locale === 'ru');

const sortedProjects = projects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
---

<BaseLayout title="Проекты" description="Избранные веб-проекты, индивидуальные приложения и цифровые инструменты.">
  <div class="container">
    <header class="page-header">
      <h1 class="page-title">Проекты</h1>
      <p class="subtitle">Подборка выполненных работ, цифровых утилит и экологичных веб-сервисов.</p>
    </header>

    {sortedProjects.length > 0 ? (
      <div class="projects-grid">
        {sortedProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    ) : (
      <p class="empty-state">В настоящее время нет доступных проектов.</p>
    )}
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  .page-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-2);
  }

  .subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-8);
    margin-top: var(--space-4);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .empty-state {
    color: var(--color-text-muted);
    font-style: italic;
    padding-top: var(--space-8);
  }
</style>
