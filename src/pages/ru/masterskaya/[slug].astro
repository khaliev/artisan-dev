---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('playground', ({ data }) => data.locale === 'ru');
  return items.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const formattedDate = new Date(data.date).toLocaleDateString('ru-RU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

function getYouTubeEmbedUrl(url?: string): string | null {
  if (!url) return null;
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
  const match = url.match(regExp);
  return match && match[2].length === 11 ? `https://www.youtube.com/embed/${match[2]}` : null;
}

const youtubeEmbedUrl = getYouTubeEmbedUrl(data.youtubeUrl);

const typeLabels: Record<string, string> = {
  experiment: 'Эксперимент',
  component: 'Компонент',
  prototype: 'Прототип',
  challenge: 'Задача',
  'lab-note': 'Заметка',
};
---

<BaseLayout
  title={data.title}
  description={data.summary}
  image={data.coverImage}
>
  <article class="item-detail">
    <div class="container">
      <a href="/ru/masterskaya/" class="back-link">&larr; Назад в Мастерскую</a>

      <header class="detail-header">
        <div class="header-meta">
          <time datetime={new Date(data.date).toISOString()}>{formattedDate}</time>
          <span class="badge-type">{typeLabels[data.type] ?? data.type}</span>
        </div>

        <h1 class="item-title">{data.title}</h1>
        <p class="item-summary">{data.summary}</p>

        {data.stack && data.stack.length > 0 && (
          <div class="stack-tags">
            {data.stack.map((tech) => (
              <span class="tag">{tech}</span>
            ))}
          </div>
        )}

        {(data.demoUrl || data.repoUrl) && (
          <div class="item-links">
            {data.demoUrl && (
              <a href={data.demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                Демо ↗
              </a>
            )}
            {data.repoUrl && (
              <a href={data.repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                Исходный код ↗
              </a>
            )}
          </div>
        )}
      </header>

      {data.coverImage && (
        <div class="cover-wrapper">
          <img src={data.coverImage} alt={data.title} class="cover-image" />
        </div>
      )}

      <div class="content-body">
        <Content />
      </div>

      {youtubeEmbedUrl && (
        <section class="video-section">
          <h2>Видео-демонстрация</h2>
          <div class="video-responsive">
            <iframe
              src={youtubeEmbedUrl}
              title={`Видео — ${data.title}`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </section>
      )}

      {data.gallery && data.gallery.length > 0 && (
        <section class="gallery-section">
          <h2>Галерея</h2>
          <div class="gallery-grid">
            {data.gallery.map((imgUrl, index) => (
              <img src={imgUrl} alt={`${data.title} — ${index + 1}`} loading="lazy" class="gallery-image" />
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .item-detail {
    padding-top: var(--space-4);
  }

  .back-link {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: var(--space-6);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .detail-header {
    margin-bottom: var(--space-8);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .badge-type {
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
  }

  .item-title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }

  .item-summary {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
    max-width: 720px;
  }

  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .tag {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-hover);
    color: var(--color-text);
  }

  .item-links {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-6);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .btn-primary {
    background-color: var(--color-accent);
    color: #ffffff;
  }

  .btn-primary:hover {
    background-color: var(--color-accent-hover);
    color: #ffffff;
  }

  .btn-secondary {
    border: 1px solid var(--color-border);
    color: var(--color-text);
    background-color: var(--color-surface);
  }

  .btn-secondary:hover {
    background-color: var(--color-surface-hover);
  }

  .cover-wrapper {
    margin-bottom: var(--space-12);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .cover-image {
    width: 100%;
    max-height: 500px;
    object-fit: cover;
    display: block;
  }

  .content-body {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    max-width: 720px;
    margin-bottom: var(--space-12);
  }

  .content-body :global(h2) {
    font-size: var(--text-2xl);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
  }

  .content-body :global(h3) {
    font-size: var(--text-xl);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .content-body :global(p) {
    margin-bottom: var(--space-4);
  }

  .content-body :global(pre) {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    overflow-x: auto;
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }

  .content-body :global(code:not(pre code)) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1px 6px;
  }

  .content-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }

  .content-body :global(th),
  .content-body :global(td) {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .content-body :global(th) {
    background-color: var(--color-surface);
    font-weight: 600;
  }

  .content-body :global(ul),
  .content-body :global(ol) {
    padding-left: var(--space-6);
    margin-bottom: var(--space-4);
  }

  .content-body :global(li) {
    margin-bottom: var(--space-1);
  }

  .video-section,
  .gallery-section {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .video-section h2,
  .gallery-section h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-6);
  }

  .video-responsive {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .video-responsive iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .gallery-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }
</style>
