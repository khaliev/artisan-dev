---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButton from '../../components/CTAButton.astro';
import { siteConfig } from '../../data/site';
---

<BaseLayout
  title="Главная"
  description="Адлан — независимый веб-разработчик из города Реймс (Франция, регион Гранд-Эст), специализирующийся на экологичных и доступных веб-сайтах."
>
  <div class="container">
    <section class="hero">
      <h1 class="hero-title">{siteConfig.name}</h1>
      
      <p class="hero-definition">
        Адлан — <strong>независимый веб-разработчик и цифровой ремесленник</strong> из города Реймс (Франция), 
        специализирующийся на создании экологичных, быстрыx и доступных веб-сайтов (стандарты WCAG AA).
      </p>

      <p class="hero-tagline">{siteConfig.tagline.ru}</p>

      <div class="hero-actions">
        <CTAButton href="/ru/proekty/" variant="primary">Посмотреть проекты</CTAButton>
        <CTAButton href="/ru/obo-mne/" variant="outline">Подробнее обо мне</CTAButton>
      </div>
    </section>

    <section class="geo-local-section">
      <h2>География работы и локальное присутствие</h2>
      <p>
        Находясь в Реймсе (регион Гранд-Эст, Франция), я работаю с компаниями и проектами в таких городах, как 
        <strong>Реймс</strong>, <strong>Шалон-ан-Шампань</strong>, <strong>Труа</strong>, <strong>Эперне</strong>, 
        <strong>Шарлевиль-Мезьер</strong> и <strong>Суассон</strong>, а также дистанционно.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    max-width: 800px;
  }

  .hero-title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }

  .hero-definition {
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .hero-tagline {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .geo-local-section {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    max-width: 720px;
  }

  .geo-local-section h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .geo-local-section p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }
</style>
