---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButton from '../../components/CTAButton.astro';
import Hero from '../../components/Hero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import StatsStrip from '../../components/StatsStrip.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import MethodSteps from '../../components/MethodSteps.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { siteConfig } from '../../data/site';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => data.locale === 'ru'))
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 3);

const stats = [
  { value: "3+", label: "проектов сдано клиентам" },
  { value: "0", label: "сторонних cookies и трекеров" },
  { value: "AA", label: "соответствие WCAG 2.2 в каждой работе" },
  { value: "100", label: "целевая оценка Lighthouse" },
];

const services = [
  {
    icon: "globe",
    title: "Сайты-визитки и лендинги",
    description: "Сайты, которые представляют ваш бизнес и превращают посетителей в клиентов.",
    points: ["SEO и оптимизированный контент", "Лёгкие страницы (< 100 КБ)", "Формы и CTA в комплекте"],
  },
  {
    icon: "code",
    title: "Веб-приложения на заказ",
    description: "Инструменты под ваши процессы: дашборды, платформы, админки.",
    points: ["Astro, TypeScript, Node.js", "Быстрая статическая архитектура", "Доступные интерфейсы"],
  },
  {
    icon: "gauge",
    title: "Аудит производительности и доступности",
    description: "Диагностика вашего текущего сайта с цифрами и план действий.",
    points: ["Анализ Core Web Vitals", "Соответствие WCAG 2.2 AA", "Практичный отчёт"],
  },
  {
    icon: "leaf",
    title: "Экодизайн и цифровая экономия",
    description: "Сайты с минимальным воздействием на окружающую среду, без лишнего.",
    points: ["0 сторонних cookies", "Чистый и долговечный код", "«Зелёный» хостинг"],
  },
  {
    icon: "wrench",
    title: "Поддержка и развитие",
    description: "Спокойствие после запуска: обновления, исправления, новые функции.",
    points: ["Прозрачный SLA", "Безопасные обновления", "Regular backups"],
  },
  {
    icon: "terminal",
    title: "Инструменты для разработчиков и open source",
    description: "CLI и библиотеки, созданные для разработчиков.",
    points: ["CLI на TypeScript", "В открытом доступе", "Документированные"],
  },
];

const methodSteps = [
  {
    title: "Обсуждение и скоуп",
    description: "Определяем цели, аудиторию и объём работ. Вы точно знаете, за что платите.",
  },
  {
    title: "Проектирование и контент",
    description: "Структура, пользовательские сценарии и контент для конверсии — до первой строки кода.",
  },
  {
    title: "Разработка и тестирование",
    description: "Я разрабатываю, тестирую и проверяю доступность, производительность и совместимость.",
  },
  {
    title: "Запуск и поддержка",
    description: "Аккуратный запуск, обучение и сопровождение после релиза.",
  },
];
---

<BaseLayout
  title="Главная"
  description="Адлан — независимый веб-разработчик и консультант, специализирующийся на высокопроизводительных, доступных и экологичных сайтах."
>
  <div class="container">
    <!-- Hero -->
    <Hero
      badge="Доступен — стажировка с сент. 2026 и фриланс-проекты"
      title={`
        <span class="hero-accent">Быстрые</span> и доступные сайты,
        созданные для <span class="hero-accent">конверсии</span>.
      `}
      subtitle="Независимый веб-разработчик из Реймса. Я создаю устойчивые цифровые инструменты, объединяющие техническое превосходство и бизнес-цели."
      primaryCta={{ label: "Запустить проект", href: `mailto:${siteConfig.email}` }}
      secondaryCta={{ label: "Посмотреть работы", href: "/ru/proekty/" }}
      proofs={["WCAG 2.2 AA", "100% Производительность", "0 сторонних cookies"]}
    />
  </div>

  <!-- Proof -->
  <section class="home-section stats-section" aria-label="Ключевые показатели" data-reveal>
    <div class="container">
      <StatsStrip items={stats} />
    </div>
  </section>

  <!-- Services -->
  <section class="home-section" data-reveal>
    <div class="container">
      <SectionHeading
        eyebrow="Экспертиза"
        title="Индивидуальные решения для вашего роста"
        subtitle="От высокопроизводительных лендингов до сложных бизнес-приложений — я предлагаю точные технические ответы на любые задачи."
      />
      <div class="services-grid">
        {services.map((service) => (
          <ServiceCard
            icon={service.icon}
            title={service.title}
            description={service.description}
            points={service.points}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Selected projects -->
  <section class="home-section projects-section" data-reveal>
    <div class="container">
      <SectionHeading
        eyebrow="Работы"
        title="Избранные проекты"
        subtitle="Обзор недавних работ, объединяющих доступность, экодизайн и влияние на бизнес."
      />
      <div class="projects-grid">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
      <div class="section-cta">
        <CTAButton href="/ru/proekty/" variant="secondary">Все проекты →</CTAButton>
      </div>
    </div>
  </section>

  <!-- Method -->
  <section class="home-section method-section" data-reveal>
    <div class="container">
      <SectionHeading
        eyebrow="Процесс"
        title="Прозрачный рабочий процесс"
        subtitle="Структурированный подход из четырех этапов для обеспечения успеха вашего проекта."
      />
      <MethodSteps steps={methodSteps} />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="home-section" data-reveal>
    <div class="container">
      <div class="final-cta">
        <p class="final-cta-eyebrow">Обсудим ваш проект</p>
        <h2 class="final-cta-title">Готовы оптимизировать свое онлайн-присутствие?</h2>
        <p class="final-cta-text">
          Давайте обсудим ваши цели во время бесплатного звонка. Гарантированный ответ в течение 24 рабочих часов.
        </p>
        <div class="final-cta-actions">
          <CTAButton href={`mailto:${siteConfig.email}`} variant="primary">Связаться со мной</CTAButton>
          <div class="social-links">
            <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <span class="separator">/</span>
            <a href={siteConfig.socials.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Local SEO block -->
  <section class="home-section geo-local-section" data-reveal>
    <div class="container">
      <div class="geo-card">
        <h2>Региональная экспертиза и глобальный охват</h2>
        <p>
          Базируюсь в <strong>Реймсе, Франция</strong>. Помогаю компаниям и организациям в регионе Гранд-Эст (Шалон, Труа, Эперне) и по всему миру в их устойчивой цифровой трансформации.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-section {
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
  }

  .stats-section {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-12);
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .projects-section {
    background-color: var(--color-surface);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-8);
    margin-top: var(--space-12);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .section-cta {
    margin-top: var(--space-12);
    text-align: center;
  }

  .method-section {
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .final-cta {
    background-color: var(--color-accent);
    background-image: radial-gradient(
      circle at 15% 15%,
      color-mix(in srgb, var(--color-energy) 28%, transparent),
      transparent 60%
    );
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: var(--space-16) var(--space-8);
    text-align: center;
    max-width: 860px;
    margin: 0 auto;
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
  }

  .final-cta-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-contrast);
    opacity: 0.85;
    margin-bottom: var(--space-3);
  }

  .final-cta-title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
    color: var(--color-accent-contrast);
  }

  .final-cta-text {
    font-size: var(--text-lg);
    color: var(--color-accent-contrast);
    opacity: 0.9;
    margin-bottom: var(--space-8);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
    line-height: var(--leading-relaxed);
  }

  .final-cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .final-cta :global(.btn-primary) {
    background-color: var(--color-accent-contrast);
    color: var(--color-accent);
    border-color: var(--color-accent-contrast);
  }

  .final-cta :global(.btn-primary:hover) {
    background-color: color-mix(in srgb, var(--color-accent-contrast) 90%, var(--color-accent));
  }

  .social-links {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent-contrast);
    opacity: 0.92;
  }

  .social-links a:hover {
    color: var(--color-accent-contrast);
    text-decoration: underline;
  }

  .separator {
    opacity: 0.4;
  }

  .geo-local-section {
    padding-top: var(--space-12);
  }

  .geo-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    max-width: 720px;
    box-shadow: var(--shadow-sm);
  }

  .geo-card h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .geo-card p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }
</style>