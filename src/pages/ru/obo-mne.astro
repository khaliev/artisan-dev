---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Timeline from '../../components/Timeline.astro';
import CTAButton from '../../components/CTAButton.astro';
import FAQ from '../../components/FAQ.astro';
import { siteConfig } from '../../data/site';
import { generatePersonSchema, generateFAQSchema } from '../../lib/seo';
import { getCollection } from 'astro:content';

const rawExperiences = await getCollection('experience');
const experiences = rawExperiences
  .sort((a, b) => {
    if (a.data.current && !b.data.current) return -1;
    if (!a.data.current && b.data.current) return 1;
    return parseInt(b.data.dateStart) - parseInt(a.data.dateStart);
  })
  .map((e) => e.data);

const faqItems = [
  {
    question: "Где вы находитесь и в каких регионах работаете?",
    answer: "Я нахожусь в городе Реймс (регион Гранд-Эст, Франция). Я работаю локально в городах Реймс, Шалон-ан-Шампань, Труа, Эперне, Шарлевиль-Мезьер и Суассон, а также дистанционно по всему миру."
  },
  {
    question: "Что такое экологичный веб-сайт (эко-дизайн)?",
    answer: "Экологичный веб-сайт оптимизирован для минимального потребления вычислительных ресурсов и энергии. Это означает чистый код, отсутствие тяжелых трекеров и мгновенную загрузку страниц."
  },
  {
    question: "Какие технологии вы используете в разработке?",
    answer: "Основной стек включает Astro, TypeScript, семантический HTML5 и Vanilla CSS. Это гарантирует максимальную скорость, безопасность и простоту поддержки."
  },
  {
    question: "Соответствуют ли сайты стандартам доступности?",
    answer: "Да, все разрабатываемые сайты соответствуют стандарту доступности WCAG 2.2 AA (полная навигация с клавиатуры, контрастность цветов и доступность для людей с ограниченными возможностями)."
  }
];

const personSchema = generatePersonSchema('ru');
const faqSchema = generateFAQSchema(faqItems);
---

<BaseLayout
  title="Обо мне"
  description="Адлан — независимый веб-разработчик из города Реймс (Франция). Узнайте о его опыте, философии эко-дизайна и ответы на частые вопросы."
  jsonLd={[personSchema, faqSchema]}
>
  <div class="container">
    <header class="page-header">
      <div class="expertise-badge">Техническая экспертиза и консультации</div>
      <h1 class="page-title">Обо мне</h1>
      <p class="subtitle">
        Адлан — <strong>цифровой ремесленник и независимый веб-разработчик</strong> из города Реймс (Франция), 
        специализирующийся на экологичных веб-сайтах и производительности.
      </p>
    </header>

    <div class="profile-grid">
      <section class="expertise-section">
        <h2>Экспертиза и специализации</h2>
        <div class="expertise-cards">
          <div class="exp-card">
            <h3>Производительность веб и Core Web Vitals</h3>
            <p>Радикальная оптимизация для высокого технического SEO и максимизации конверсий.</p>
          </div>
          <div class="exp-card">
            <h3>Доступность (WCAG 2.2 AA)</h3>
            <p>Инклюзивный дизайн, гарантирующий универсальный доступ к вашим цифровым сервисам.</p>
          </div>
          <div class="exp-card">
            <h3>Современная архитектура и эко-дизайн</h3>
            <p>Разработка на Astro и TypeScript для надежных, легких и устойчивых сайтов.</p>
          </div>
          <div class="exp-card">
            <h3>SEO и GEO (Generative Engine Optimization)</h3>
            <p>Видимость в Google и ИИ-движках (ChatGPT, Perplexity, Gemini) через структурированные данные и семантический контент.</p>
          </div>
        </div>
      </section>

      <section class="bio-section">
      <div class="bio-content">
        <h2>Философия и подход</h2>
        <p>
          Я отношусь к веб-разработке как к ремеслу: каждая строка кода пишется с заботой, простотой и расчетом на долговечность. 
          Я предпочитаю легкие статические архитектуры без лишних зависимостей.
        </p>
        <p>
          Находясь в Реймсе, я помогаю организациям и авторам создавать экологичные цифровые инструменты.
        </p>

        <div class="cta-wrapper">
          <CTAButton href={`mailto:${siteConfig.email}`} variant="primary">
            Связаться по email
          </CTAButton>
          <CTAButton href={siteConfig.socials.github} variant="outline" external>
            Посмотреть GitHub
          </CTAButton>
        </div>
      </div>
      </section>
    </div>

    <section class="experience-section">
      <h2>Опыт и карьера</h2>
      <Timeline items={experiences} locale="ru" />
    </section>

    <FAQ items={faqItems} title="Часто задаваемые вопросы (FAQ)" />
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    max-width: 800px;
  }

  .page-title {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
    margin-bottom: var(--space-4);
    line-height: 1.1;
  }

  .subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .profile-grid {
    display: grid;
    gap: var(--space-16);
    margin-bottom: var(--space-24);
  }

  @media (min-width: 1024px) {
    .profile-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .expertise-section h2, .bio-section h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-8);
    position: relative;
    padding-bottom: var(--space-2);
  }

  .expertise-section h2::after, .bio-section h2::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 3px;
    background-color: var(--color-accent);
  }

  .expertise-cards {
    display: grid;
    gap: var(--space-4);
  }

  .exp-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-6);
    border-radius: var(--radius-md);
  }

  .exp-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
    color: var(--color-accent);
  }

  .exp-card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }

  .expertise-badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-4);
  }

  .bio-content {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .bio-content p {
    margin-bottom: var(--space-4);
  }

  .cta-wrapper {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .experience-section {
    padding-top: var(--space-16);
    border-top: 1px solid var(--color-border);
    margin-bottom: var(--space-24);
  }

  .experience-section h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-12);
  }
</style>
