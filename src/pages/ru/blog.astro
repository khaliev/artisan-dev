---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Блог / Журнал" description="Статьи и заметки о веб-разработке и цифровом ремесле.">
  <div class="container">
    <header class="page-header">
      <h1>Блог / Журнал</h1>
      <p class="subtitle">Статьи, размышления и технические заметки.</p>
    </header>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }
  h1 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-2);
  }
  .subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
</style>
