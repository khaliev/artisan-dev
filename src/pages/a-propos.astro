---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import CTAButton from '../components/CTAButton.astro';
import FAQ from '../components/FAQ.astro';
import { siteConfig } from '../data/site';
import { generatePersonSchema, generateFAQSchema } from '../lib/seo';

const experiences = [
  {
    role: "Développeur Web Indépendant & Artisan du Numérique",
    company: "Artisan Développeur",
    dateStart: "2024",
    current: true,
    location: "Reims, France",
    summary: "Conception et réalisation d'applications web sur-mesure, éco-conçues, rapides et accessibles.",
    details: [
      "Développement de sites statiques haute performance avec Astro et TypeScript.",
      "Accompagnement des entreprises locales en Région Grand Est dans leur présence numérique.",
      "Optimisation de la performance (Core Web Vitals) et de l'accessibilité WCAG AA."
    ],
    skills: ["Astro", "TypeScript", "Éco-conception", "Accessibility", "CSS Custom Properties"]
  },
  {
    role: "Développeur Front-End",
    company: "Studio Numérique",
    dateStart: "2022",
    dateEnd: "2024",
    location: "Grand Est, France",
    summary: "Création d'interfaces utilisateur modernes et réactives pour des projets clients variés.",
    details: [
      "Intégration d'interfaces web responsives et respect des standards Web.",
      "Mise en place de tests d'intégration et audit de performance."
    ],
    skills: ["JavaScript", "HTML5/CSS3", "Design Systems", "Web Performance"]
  }
];

const faqItems = [
  {
    question: "Où êtes-vous basé et quelle est votre zone d'intervention ?",
    answer: "Je suis basé à Reims dans la région Grand Est. J'interviens localement à Reims, Châlons-en-Champagne, Troyes, Épernay, Charleville-Mézières et Soissons, ainsi qu'à distance pour des projets dans toute la France."
  },
  {
    question: "Qu'est-ce qu'un site internet éco-conçu ?",
    answer: "Un site éco-conçu est optimisé pour consommer un minimum de ressources informatiques et d'énergie. Cela se traduit par un code épuré, des pages légères, l'absence de traqueurs lourds et un temps de chargement quasi-instantané qui réduit l'empreinte carbone."
  },
  {
    question: "Quelles technologies utilisez-vous pour développer vos projets ?",
    answer: "J'utilise principalement Astro, TypeScript, du HTML5 sémantique et du CSS Vanilla. Cette architecture moderne garantit des performances élevées, une sécurité optimale et une maintenance facilitée."
  },
  {
    question: "Les sites sont-ils conformes aux normes d'accessibilité ?",
    answer: "Oui, la totalité de mes créations respecte le niveau WCAG 2.2 AA. La navigation complète au clavier, le contraste des couleurs vérifié et l'usage de balises sémantiques sont systématiquement appliqués."
  }
];

const personSchema = generatePersonSchema('fr');
const faqSchema = generateFAQSchema(faqItems);
---

<BaseLayout
  title="À propos"
  description="Adlan est un développeur web indépendant basé à Reims (Grand Est, France). Découvrir son parcours, sa philosophie d'éco-conception et sa foire aux questions."
  jsonLd={[personSchema, faqSchema]}
>
  <div class="container">
    <header class="page-header">
      <h1 class="page-title">À propos</h1>
      <!-- Phrase définitionnelle pour l'extraction GEO -->
      <p class="subtitle">
        Adlan est un <strong>artisan du numérique et développeur web indépendant</strong> basé à Reims (Grand Est, France), 
        spécialisé dans les sites internet éco-conçus et la performance web.
      </p>
    </header>

    <section class="bio-section">
      <div class="bio-content">
        <h2>Philosophie & Démarche</h2>
        <p>
          Je conçois le développement web comme un artisanat : chaque ligne de code doit être pensée avec soin, 
          sobriété et durabilité. Loin des usines à gaz informatiques, je privilégie des architectures légères,
          sans superflu, qui durent dans le temps.
        </p>
        <p>
          Basé à Reims, j'interviens dans toute la région Grand Est ({siteConfig.location.cities.slice(0, 5).join(', ')}) 
          pour aider les projets locaux à se doter d'outils numériques éco-conçus et accessibles à tous.
        </p>

        <div class="cta-wrapper">
          <CTAButton href={`mailto:${siteConfig.email}`} variant="primary">
            Me contacter par email
          </CTAButton>
          <CTAButton href={siteConfig.socials.github} variant="outline" external>
            Voir GitHub
          </CTAButton>
        </div>
      </div>
    </section>

    <section class="experience-section">
      <h2>Parcours & Expérience</h2>
      <Timeline items={experiences} />
    </section>

    <FAQ items={faqItems} title="Questions fréquentes (FAQ)" />
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  .page-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-2);
  }

  .subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .bio-section {
    margin-bottom: var(--space-12);
  }

  .bio-content {
    max-width: 720px;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .bio-content h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .bio-content p {
    margin-bottom: var(--space-4);
    color: var(--color-text-muted);
  }

  .cta-wrapper {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-6);
    flex-wrap: wrap;
  }

  .experience-section {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    max-width: 720px;
  }

  .experience-section h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-8);
  }
</style>
