---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="À propos" description="Présentation et parcours d'Adlan, développeur web indépendant.">
  <div class="container">
    <header class="page-header">
      <h1>À propos</h1>
      <p class="subtitle">Artisan du numérique & développeur web indépendant.</p>
    </header>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }
  h1 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-2);
  }
  .subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
</style>
