---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout title="Accueil" description="Portfolio et journal d'un développeur web indépendant en France, Grand Est.">
  <div class="container">
    <section class="hero">
      <h1 class="hero-title">{siteConfig.name}</h1>
      <p class="hero-tagline">{siteConfig.tagline.fr}</p>
      <p class="hero-location">
        Basé à {siteConfig.location.cities[0]} ({siteConfig.location.region}, {siteConfig.location.country}).
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }
  .hero-title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }
  .hero-tagline {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }
  .hero-location {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
