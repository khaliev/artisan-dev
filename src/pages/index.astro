---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title="Accueil"
  description="Adlan est un développeur web indépendant basé à Reims (Grand Est, France), spécialisé dans la création de sites web sur-mesure, éco-conçus et accessibles."
>
  <div class="container">
    <section class="hero">
      <h1 class="hero-title">{siteConfig.name}</h1>
      
      <!-- Phrase définitionnelle claire pour les moteurs génératifs (GEO) -->
      <p class="hero-definition">
        Adlan est un <strong>développeur web indépendant et artisan du numérique</strong> basé à Reims, 
        spécialisé dans la création de sites internet éco-conçus, rapides et accessibles (normes WCAG AA).
      </p>

      <p class="hero-tagline">{siteConfig.tagline.fr}</p>

      <div class="hero-actions">
        <CTAButton href="/projets/" variant="primary">Découvrir les projets</CTAButton>
        <CTAButton href="/a-propos/" variant="outline">En savoir plus</CTAButton>
      </div>
    </section>

    <!-- Bloc SEO Local : Zone d'intervention rédigée naturellement -->
    <section class="geo-local-section">
      <h2>Zone d'intervention & Ancrage local</h2>
      <p>
        Installé à Reims dans la région Grand Est, j'accompagne les entreprises, collectivités et créateurs locaux 
        à <strong>Reims</strong>, <strong>Châlons-en-Champagne</strong>, <strong>Troyes</strong>, <strong>Épernay</strong>, 
        <strong>Charleville-Mézières</strong> et <strong>Soissons</strong>. Mon approche privilégie la proximité, la transparence 
        et la réalisation de projets web durables adaptés aux spécificités du territoire.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    max-width: 800px;
  }

  .hero-title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }

  .hero-definition {
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .hero-tagline {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .geo-local-section {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    max-width: 720px;
  }

  .geo-local-section h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .geo-local-section p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }
</style>
