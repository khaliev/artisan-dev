---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import { getCollection } from 'astro:content';

const testimonials = [
  {
    name: 'Claire',
    role: 'Shop manager',
    quote: 'End-to-end support: the site is fast, elegant, and immediately increased our appointment requests.',
    photo: '/avatars/claire.jpg',
  },
  {
    name: 'Thomas',
    role: 'Restaurateur',
    quote: 'Delivered on time, clear communication, and a result that lives up to expectations. I highly recommend.',
    photo: '/avatars/thomas.jpg',
  },
  {
    name: 'Sophie',
    role: 'Interior architect',
    quote: 'Adlan translated our universe into an accessible, polished website. The work is clean, precise, professional.',
    photo: '/avatars/sophie.jpg',
  },
];

const projects = await getCollection('projects', ({ data }) => data.locale === 'en');

const sortedProjects = projects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
---

<BaseLayout title="Projects" description="Selection of web projects, custom applications, and digital tools.">
  <div class="container">
    <header class="page-header">
      <h1 class="page-title">Projects</h1>
      <p class="subtitle">Selected works, bespoke web apps, and eco-designed projects.</p>
    </header>

    {sortedProjects.length > 0 ? (
      <div class="projects-grid">
        {sortedProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    ) : (
      <p class="empty-state">No projects available at the moment.</p>
    )}

    <section class="testimonials-section" data-reveal>
      <SectionHeading
        eyebrow="Client reviews"
        title="They trusted me"
        subtitle="What those who entrusted me with their project have to say."
      />
      <div class="testimonials-grid">
        {testimonials.map((t) => (
          <TestimonialCard name={t.name} role={t.role} quote={t.quote} photo={t.photo} ratingLabel={`Rating: ${t.rating ?? 5} out of 5`} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  .page-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-2);
  }

  .subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-8);
    margin-top: var(--space-4);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .empty-state {
    color: var(--color-text-muted);
    font-style: italic;
    padding-top: var(--space-8);
  }

  .testimonials-section {
    padding-top: var(--space-24);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .testimonials-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
