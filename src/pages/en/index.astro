---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButton from '../../components/CTAButton.astro';
import Hero from '../../components/Hero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import StatsStrip from '../../components/StatsStrip.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import MethodSteps from '../../components/MethodSteps.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { siteConfig } from '../../data/site';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => data.locale === 'en'))
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 3);

const stats = [
  { value: "3+", label: "projects delivered for clients" },
  { value: "0", label: "third-party cookies or trackers" },
  { value: "AA", label: "WCAG 2.2 compliance on every delivery" },
  { value: "100", label: "target Lighthouse performance score" },
];

const services = [
  {
    icon: "globe",
    title: "Showcase sites & landing pages",
    description: "Websites that present your business and turn visitors into customers.",
    points: ["SEO & optimized content", "Lightweight pages (< 100 KB)", "Forms & CTAs built in"],
  },
  {
    icon: "code",
    title: "Custom web applications",
    description: "Tools built around your workflows: dashboards, platforms, back-offices.",
    points: ["Astro, TypeScript, Node.js", "Fast static architecture", "Accessible interfaces"],
  },
  {
    icon: "gauge",
    title: "Performance & accessibility audit",
    description: "A data-driven diagnosis of your current site plus a prioritized action plan.",
    points: ["Core Web Vitals analyzed", "WCAG 2.2 AA compliance", "Actionable report"],
  },
  {
    icon: "leaf",
    title: "Eco-design & digital sobriety",
    description: "Websites with minimal environmental impact, no bloat.",
    points: ["0 third-party cookies", "Clean, durable code", "Green hosting"],
  },
  {
    icon: "wrench",
    title: "Maintenance & evolution",
    description: "Peace of mind after launch: updates, fixes, and new features.",
    points: ["Transparent SLA", "Secure updates", "Regular backups"],
  },
  {
    icon: "terminal",
    title: "Dev tools & open source",
    description: "Command-line tools and libraries built for developers.",
    points: ["TypeScript CLIs", "Published as open source", "Documented"],
  },
];

const methodSteps = [
  {
    title: "Discovery & scoping",
    description: "We define your goals, audience, and scope. You know exactly what you're paying for.",
  },
  {
    title: "Design & content",
    description: "Structure, user journeys, and conversion-focused content — before the first line of code.",
  },
  {
    title: "Development & testing",
    description: "I build, test, and validate accessibility, performance, and compatibility end to end.",
  },
  {
    title: "Launch & support",
    description: "A careful deployment, onboarding, and ongoing support so your site lasts.",
  },
];
---

<BaseLayout
  title="Home"
  description="Adlan is an independent web developer & consultant specializing in high-performance, accessible, and eco-designed websites."
>
  <div class="container">
    <!-- Hero -->
    <Hero
      badge="Available — apprenticeship Sept. 2026 & freelance missions"
      title={`
        High-<span class="hero-accent">performance</span>, accessible
        websites engineered to <span class="hero-accent">convert</span>.
      `}
      subtitle="Independent web developer based in Reims, France. I build sustainable digital tools that bridge technical excellence with business goals."
      primaryCta={{ label: "Start a project", href: `mailto:${siteConfig.email}` }}
      secondaryCta={{ label: "View work", href: "/en/projects/" }}
      proofs={["WCAG 2.2 AA", "100% Performance", "0 third-party cookies"]}
    />
  </div>

  <!-- Proof -->
  <section class="home-section stats-section" aria-label="Key numbers & results" data-reveal>
    <div class="container">
      <StatsStrip items={stats} />
    </div>
  </section>

  <!-- Services -->
  <section class="home-section" data-reveal>
    <div class="container">
      <SectionHeading
        eyebrow="Expertise"
        title="Custom solutions for your growth"
        subtitle="From high-performance landing pages to complex business applications, I deliver precise technical answers to every need."
      />
      <div class="services-grid">
        {services.map((service) => (
          <ServiceCard
            icon={service.icon}
            title={service.title}
            description={service.description}
            points={service.points}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Selected projects -->
  <section class="home-section projects-section" data-reveal>
    <div class="container">
      <SectionHeading
        eyebrow="Work"
        title="Selected projects"
        subtitle="A snapshot of recent work blending accessibility, eco-design, and business impact."
      />
      <div class="projects-grid">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
      <div class="section-cta">
        <CTAButton href="/en/projects/" variant="secondary">All projects →</CTAButton>
      </div>
    </div>
  </section>

  <!-- Method -->
  <section class="home-section method-section" data-reveal>
    <div class="container">
      <SectionHeading
        eyebrow="Process"
        title="A transparent workflow"
        subtitle="A structured four-step approach to ensure your project's success."
      />
      <MethodSteps steps={methodSteps} />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="home-section" data-reveal>
    <div class="container">
      <div class="final-cta">
        <p class="final-cta-eyebrow">Let's talk about your project</p>
        <h2 class="final-cta-title">Ready to optimize your online presence?</h2>
        <p class="final-cta-text">
          Let's discuss your goals during a free discovery call. Guaranteed reply within 24 business hours.
        </p>
        <div class="final-cta-actions">
          <CTAButton href={`mailto:${siteConfig.email}`} variant="primary">Get in touch</CTAButton>
          <div class="social-links">
            <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <span class="separator">/</span>
            <a href={siteConfig.socials.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Local SEO block -->
  <section class="home-section geo-local-section" data-reveal>
    <div class="container">
      <div class="geo-card">
        <h2>Regional Expertise & Global Reach</h2>
        <p>
          Based in <strong>Reims, France</strong>, I help businesses and institutions across the Grand Est region (Châlons, Troyes, Épernay) and beyond with their sustainable digital transformation.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-section {
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
  }

  .stats-section {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-12);
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .projects-section {
    background-color: var(--color-surface);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-8);
    margin-top: var(--space-12);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .section-cta {
    margin-top: var(--space-12);
    text-align: center;
  }

  .method-section {
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .final-cta {
    background-color: var(--color-accent);
    background-image: radial-gradient(
      circle at 15% 15%,
      color-mix(in srgb, var(--color-energy) 28%, transparent),
      transparent 60%
    );
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: var(--space-16) var(--space-8);
    text-align: center;
    max-width: 860px;
    margin: 0 auto;
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
  }

  .final-cta-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-contrast);
    opacity: 0.85;
    margin-bottom: var(--space-3);
  }

  .final-cta-title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
    color: var(--color-accent-contrast);
  }

  .final-cta-text {
    font-size: var(--text-lg);
    color: var(--color-accent-contrast);
    opacity: 0.9;
    margin-bottom: var(--space-8);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
    line-height: var(--leading-relaxed);
  }

  .final-cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .final-cta :global(.btn-primary) {
    background-color: var(--color-accent-contrast);
    color: var(--color-accent);
    border-color: var(--color-accent-contrast);
  }

  .final-cta :global(.btn-primary:hover) {
    background-color: color-mix(in srgb, var(--color-accent-contrast) 90%, var(--color-accent));
  }

  .social-links {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent-contrast);
    opacity: 0.92;
  }

  .social-links a:hover {
    color: var(--color-accent-contrast);
    text-decoration: underline;
  }

  .separator {
    opacity: 0.4;
  }

  .geo-local-section {
    padding-top: var(--space-12);
  }

  .geo-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    max-width: 720px;
    box-shadow: var(--shadow-sm);
  }

  .geo-card h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .geo-card p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }
</style>