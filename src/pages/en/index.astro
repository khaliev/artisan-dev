---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButton from '../../components/CTAButton.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import StatsStrip from '../../components/StatsStrip.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import MethodSteps from '../../components/MethodSteps.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { siteConfig } from '../../data/site';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => data.locale === 'en'))
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 3);

const stats = [
  { value: "3+", label: "projects delivered for clients" },
  { value: "0", label: "third-party cookies or trackers" },
  { value: "AA", label: "WCAG 2.2 compliance on every delivery" },
  { value: "100", label: "target Lighthouse performance score" },
];

const services = [
  {
    icon: "globe",
    title: "Showcase sites & landing pages",
    description: "Websites that present your business and turn visitors into customers.",
    points: ["SEO & optimized content", "Lightweight pages (< 100 KB)", "Forms & CTAs built in"],
  },
  {
    icon: "code",
    title: "Custom web applications",
    description: "Tools built around your workflows: dashboards, platforms, back-offices.",
    points: ["Astro, TypeScript, Node.js", "Fast static architecture", "Accessible interfaces"],
  },
  {
    icon: "gauge",
    title: "Performance & accessibility audit",
    description: "A data-driven diagnosis of your current site plus a prioritized action plan.",
    points: ["Core Web Vitals analyzed", "WCAG 2.2 AA compliance", "Actionable report"],
  },
  {
    icon: "leaf",
    title: "Eco-design & digital sobriety",
    description: "Websites with minimal environmental impact, no bloat.",
    points: ["0 third-party cookies", "Clean, durable code", "Green hosting"],
  },
  {
    icon: "wrench",
    title: "Maintenance & evolution",
    description: "Peace of mind after launch: updates, fixes, and new features.",
    points: ["Transparent SLA", "Secure updates", "Regular backups"],
  },
  {
    icon: "terminal",
    title: "Dev tools & open source",
    description: "Command-line tools and libraries built for developers.",
    points: ["TypeScript CLIs", "Published as open source", "Documented"],
  },
];

const methodSteps = [
  {
    title: "Discovery & scoping",
    description: "We define your goals, audience, and scope. You know exactly what you're paying for.",
  },
  {
    title: "Design & content",
    description: "Structure, user journeys, and conversion-focused content — before the first line of code.",
  },
  {
    title: "Development & testing",
    description: "I build, test, and validate accessibility, performance, and compatibility end to end.",
  },
  {
    title: "Launch & support",
    description: "A careful deployment, onboarding, and ongoing support so your site lasts.",
  },
];
---

<BaseLayout
  title="Home"
  description="Adlan is an independent web developer & consultant specializing in high-performance, accessible, and eco-designed websites."
>
  <div class="container">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-badge">
        <span class="hero-badge-dot" aria-hidden="true"></span>
        Available for new projects
      </div>
      <h1 class="hero-title">
        High-<span class="hero-accent">performance</span>, accessible websites engineered to <span class="hero-accent">convert</span>.
      </h1>
      <p class="hero-subtitle">
        Independent developer & web consultant. I build sustainable digital tools that bridge technical excellence with business goals.
      </p>
      <div class="hero-actions">
        <CTAButton href={`mailto:${siteConfig.email}`} variant="primary">Start a project</CTAButton>
        <CTAButton href="/en/projects/" variant="outline">View work</CTAButton>
      </div>
      <ul class="hero-proofs">
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          WCAG 2.2 AA
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          100% Performance
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          0 third-party cookies
        </li>
      </ul>
    </section>
  </div>

  <!-- Proof -->
  <section class="home-section stats-section" aria-label="Key numbers & results">
    <div class="container">
      <StatsStrip items={stats} />
    </div>
  </section>

  <!-- Services -->
  <section class="home-section">
    <div class="container">
      <SectionHeading
        eyebrow="Expertise"
        title="Custom solutions for your growth"
        subtitle="From high-performance landing pages to complex business applications, I deliver precise technical answers to every need."
      />
      <div class="services-grid">
        {services.map((service) => (
          <ServiceCard
            icon={service.icon}
            title={service.title}
            description={service.description}
            points={service.points}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Selected projects -->
  <section class="home-section projects-section">
    <div class="container">
      <SectionHeading
        eyebrow="Work"
        title="Selected projects"
        subtitle="A snapshot of recent work blending accessibility, eco-design, and business impact."
      />
      <div class="projects-grid">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
      <div class="section-cta">
        <CTAButton href="/en/projects/" variant="secondary">All projects →</CTAButton>
      </div>
    </div>
  </section>

  <!-- Method -->
  <section class="home-section method-section">
    <div class="container">
      <SectionHeading
        eyebrow="Process"
        title="A transparent workflow"
        subtitle="A structured four-step approach to ensure your project's success."
      />
      <MethodSteps steps={methodSteps} />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="home-section">
    <div class="container">
      <div class="final-cta">
        <h2 class="final-cta-title">Ready to optimize your online presence?</h2>
        <p class="final-cta-text">
          Let's discuss your goals during a free discovery call. Guaranteed reply within 24 business hours.
        </p>
        <div class="final-cta-actions">
          <CTAButton href={`mailto:${siteConfig.email}`} variant="primary">Get in touch</CTAButton>
          <div class="social-links">
            <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <span class="separator">/</span>
            <a href={siteConfig.socials.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Local SEO block -->
  <section class="home-section geo-local-section">
    <div class="container">
      <div class="geo-card">
        <h2>Regional Expertise & Global Reach</h2>
        <p>
          Based in <strong>Reims, France</strong>, I help businesses and institutions across the Grand Est region (Châlons, Troyes, Épernay) and beyond with their sustainable digital transformation.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-24);
    max-width: 900px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    background-color: var(--color-accent-light);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-8);
    border: 1px solid rgba(var(--color-accent), 0.1);
  }

  .hero-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.5); opacity: 0.5; }
    100% { transform: scale(1); opacity: 1; }
  }

  .hero-title {
    font-size: clamp(var(--text-3xl), 8vw, var(--text-5xl));
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .hero-accent {
    color: var(--color-accent);
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 640px;
    margin-bottom: var(--space-12);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-12);
  }

  .hero-proofs {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .hero-proofs li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .hero-proofs svg {
    color: var(--color-accent);
  }

  .home-section {
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
  }

  .stats-section {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-12);
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .projects-section {
    background-color: var(--color-bg);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-8);
    margin-top: var(--space-12);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .section-cta {
    margin-top: var(--space-12);
    text-align: center;
  }

  .method-section {
    background-color: var(--color-surface);
  }

  .final-cta {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-12) var(--space-8);
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    box-shadow: var(--shadow-lg);
  }

  .final-cta-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-4);
  }

  .final-cta-text {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .final-cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .social-links {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .social-links a:hover {
    color: var(--color-accent);
  }

  .separator {
    opacity: 0.3;
  }

  .geo-local-section {
    padding-top: var(--space-12);
  }

  .geo-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    max-width: 700px;
  }

  .geo-card h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .geo-card p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }
</style>
