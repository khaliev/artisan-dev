---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Badge from '../../../components/Badge.astro';
import Tag from '../../../components/Tag.astro';
import { getCollection, render } from 'astro:content';
import { generateBlogPostingSchema, getCanonicalUrl } from '../../../lib/seo';
import { siteConfig } from '../../../data/site';

export async function getStaticPaths() {
  const articles = await getCollection('blog', ({ data }) => data.locale === 'en' && !data.draft);
  return articles.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);

const pubDateFormatted = new Date(data.datePublished).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const updatedDateFormatted = data.dateUpdated
  ? new Date(data.dateUpdated).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

function getYouTubeEmbedUrl(url?: string): string | null {
  if (!url) return null;
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
  const match = url.match(regExp);
  return match && match[2].length === 11 ? `https://www.youtube.com/embed/${match[2]}` : null;
}

const youtubeEmbedUrl = getYouTubeEmbedUrl(data.youtubeUrl);

const otherArticles = await getCollection('blog', ({ data: d }) => d.locale === 'en' && d.slug !== data.slug && !d.draft);
const relatedArticles = otherArticles.slice(0, 2);

const canonicalUrl = getCanonicalUrl(Astro.url.pathname);
const blogPostingSchema = generateBlogPostingSchema({
  title: data.seoTitle || data.title,
  description: data.seoDescription || data.excerpt,
  url: canonicalUrl,
  datePublished: data.datePublished,
  dateModified: data.dateUpdated || data.datePublished,
  image: data.coverImage,
  authorName: siteConfig.author,
});
---

<BaseLayout
  title={data.seoTitle || data.title}
  description={data.seoDescription || data.excerpt}
  image={data.coverImage}
  jsonLd={blogPostingSchema}
>
  <article class="article-detail">
    <div class="container">
      <a href="/en/blog/" class="back-link">&larr; Back to articles</a>

      <header class="article-header">
        <div class="header-meta">
          <Badge variant="category">{data.category}</Badge>
          <time datetime={new Date(data.datePublished).toISOString()}>Published on {pubDateFormatted}</time>
          {updatedDateFormatted && <span class="date-updated">(updated on {updatedDateFormatted})</span>}
          {data.readingTime && <span class="reading-time">· {data.readingTime} min read</span>}
        </div>

        <h1 class="article-title">{data.title}</h1>
        <p class="article-excerpt">{data.excerpt}</p>

        <div class="author-block">
          <span class="author-name">By <strong>{siteConfig.author}</strong></span>
          <span class="author-role">— {siteConfig.name}</span>
        </div>

        {data.tags && data.tags.length > 0 && (
          <div class="article-tags">
            {data.tags.map((tag) => (
              <Tag variant="default">{tag}</Tag>
            ))}
          </div>
        )}
      </header>

      {headings && headings.length > 0 && (
        <nav class="toc-container" aria-label="Table of contents">
          <h2 class="toc-title">Table of Contents</h2>
          <ul class="toc-list">
            {headings.map((h) => (
              <li class={`toc-item depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      {data.coverImage && (
        <div class="cover-wrapper">
          <img src={data.coverImage} alt={data.title} class="cover-image" />
        </div>
      )}

      <div class="content-body">
        <Content />
      </div>

      {youtubeEmbedUrl && (
        <section class="video-section">
          <h2>Video Showcase</h2>
          <div class="video-responsive">
            <iframe
              src={youtubeEmbedUrl}
              title={`Video — ${data.title}`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </section>
      )}

      {relatedArticles.length > 0 && (
        <section class="related-section">
          <h2>Related Articles</h2>
          <div class="related-grid">
            {relatedArticles.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .article-detail {
    padding-top: var(--space-4);
  }

  .back-link {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: var(--space-6);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .article-header {
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .date-updated {
    font-style: italic;
  }

  .article-title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }

  .article-excerpt {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .author-block {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .toc-container {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .toc-title {
    font-size: var(--text-lg);
    font-family: var(--font-serif);
    margin-bottom: var(--space-3);
  }

  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .toc-item.depth-3 {
    padding-left: var(--space-4);
  }

  .cover-wrapper {
    max-width: 760px;
    margin-bottom: var(--space-12);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .cover-image {
    width: 100%;
    max-height: 450px;
    object-fit: cover;
    display: block;
  }

  .content-body {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    max-width: 720px;
    margin-bottom: var(--space-12);
  }

  .content-body :global(h2) {
    font-size: var(--text-2xl);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
  }

  .content-body :global(h3) {
    font-size: var(--text-xl);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .content-body :global(p) {
    margin-bottom: var(--space-4);
  }

  .content-body :global(ul), .content-body :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .content-body :global(li) {
    margin-bottom: var(--space-2);
  }

  .video-section {
    max-width: 760px;
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .video-section h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-6);
  }

  .video-responsive {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .video-responsive iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .related-section {
    max-width: 800px;
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .related-section h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-6);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
