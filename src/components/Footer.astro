---
import { siteConfig } from '../data/site';
import { navConfig } from '../data/nav';
import { getLocaleFromUrl, useTranslations, type Locale } from '../lib/i18n';

const pathname = Astro.url.pathname;
const locale: Locale = getLocaleFromUrl(pathname);
const t = useTranslations(locale);
const navItems = navConfig[locale];
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-col footer-brand-col">
      <p class="footer-brand">{siteConfig.name}</p>
      <p class="footer-tagline">{siteConfig.tagline[locale]}</p>
      <p class="footer-location">
        {siteConfig.location.cities[0]} · {siteConfig.location.region}, {siteConfig.location.country}
      </p>
    </div>

    <nav class="footer-col" aria-label={t('footer.navigation')}>
      <p class="footer-col-title">{t('footer.navigation')}</p>
      <ul class="footer-list">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="footer-link link-underline">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="footer-col" aria-label={t('footer.contact')}>
      <p class="footer-col-title">{t('footer.contact')}</p>
      <ul class="footer-list">
        <li>
          <a href={`mailto:${siteConfig.email}`} class="footer-mail" aria-label={`${t('footer.contactMe')} (${siteConfig.email})`}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span>{t('footer.contactMe')}</span>
          </a>
        </li>
        <li>
          <a href={siteConfig.socials.github} target="_blank" rel="noopener noreferrer" class="footer-link link-underline">GitHub</a>
        </li>
        <li>
          <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer" class="footer-link link-underline">LinkedIn</a>
        </li>
      </ul>
    </div>

    <div class="footer-col" aria-label={t('footer.location')}>
      <p class="footer-col-title">{t('footer.location')}</p>
      <ul class="footer-list">
        <li class="footer-muted">{siteConfig.location.cities[0]}, {siteConfig.location.country}</li>
        <li class="footer-muted">{siteConfig.location.region}</li>
        <li class="footer-muted">fuseau Europe/Paris</li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-copyright">
        &copy; {currentYear} {siteConfig.author}. {t('footer.rights')}
      </p>
      <p class="footer-credit">Astro · TypeScript · Eco-conception</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-8);
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  @media (min-width: 640px) {
    .footer-inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .footer-inner {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-brand {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-1);
    letter-spacing: -0.02em;
  }

  .footer-tagline {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .footer-location {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  .footer-col-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
  }

  .footer-link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-mail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-mail svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .footer-mail:hover {
    color: var(--color-text);
  }

  .footer-link:hover {
    color: var(--color-text);
  }

  .footer-muted {
    color: var(--color-text-muted);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-copyright,
  .footer-credit {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .footer-credit {
    font-family: var(--font-mono);
  }

  @media (max-width: 640px) {
    .footer-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>