---
/**
 * ReadingProgress — barre de progression de lecture.
 * Barre fine (3px) en haut fixe, couleur --accent.
 * Avance proportionnellement au scroll. JS vanilla.
 * Usage : uniquement sur les articles blog.
 */
---

<div class="reading-progress" id="reading-progress" aria-hidden="true">
  <div class="reading-progress__bar" id="reading-progress-bar"></div>
</div>

<script>
  const bar = document.getElementById('reading-progress-bar');
  if (bar) {
    let ticking = false;

    function updateProgress() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      bar.style.width = `${Math.min(progress, 100)}%`;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateProgress();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    updateProgress();
  }
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    z-index: 100;
    background-color: transparent;
    pointer-events: none;
  }

  .reading-progress__bar {
    height: 100%;
    width: 0%;
    background-color: var(--accent);
    border-radius: 0 var(--radius-full) var(--radius-full) 0;
    transition: width 50ms linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress__bar {
      transition: none;
    }
  }
</style>
