---
import CTAButton from './CTAButton.astro';

interface Props {
  badge: string;
  title: string;
  subtitle: string;
  primaryCta: { label: string; href: string };
  secondaryCta: { label: string; href: string };
  proofs: string[];
}

const { badge, title, subtitle, primaryCta, secondaryCta, proofs } = Astro.props;
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>
  </div>

  <div class="hero-float" aria-hidden="true"></div>

  <div class="hero-badge">
    <span class="hero-badge-dot" aria-hidden="true"></span>
    {badge}
  </div>

  <h1 class="hero-title" set:html={title}></h1>
  <p class="hero-subtitle">{subtitle}</p>

  <div class="hero-actions">
    <CTAButton href={primaryCta.href} variant="primary">{primaryCta.label}</CTAButton>
    <CTAButton href={secondaryCta.href} variant="outline">{secondaryCta.label}</CTAButton>
  </div>

  {proofs.length > 0 && (
    <ul class="hero-proofs">
      {proofs.map((proof) => (
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          {proof}
        </li>
      ))}
    </ul>
  )}
</section>

<script is:inline>
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var title = document.querySelector('.hero-title');
    if (!title) return;

    var walker = document.createTreeWalker(title, NodeFilter.SHOW_TEXT);
    var textNodes = [];
    while (walker.nextNode()) textNodes.push(walker.currentNode);

    var i = 0;
    textNodes.forEach(function (node) {
      var parts = node.nodeValue.split(/(\s+)/);
      var frag = document.createDocumentFragment();
      parts.forEach(function (part) {
        if (!part) return;
        if (/^\s+$/.test(part)) {
          frag.appendChild(document.createTextNode(part));
        } else {
          var span = document.createElement('span');
          span.className = 'hero-word';
          span.style.setProperty('--i', String(i++));
          span.textContent = part;
          frag.appendChild(span);
        }
      });
      node.parentNode.replaceChild(frag, node);
    });

    title.classList.add('is-animating');
  })();
</script>

<style>
  .hero {
    position: relative;
    padding-top: var(--space-16);
    padding-bottom: var(--space-24);
    max-width: 900px;
    overflow: hidden;
  }

  /* Fond vivant : grille de points + halo animé */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .hero-grid {
    position: absolute;
    top: -4rem;
    right: -4rem;
    width: 520px;
    height: 520px;
    opacity: 0.5;
    background-image: radial-gradient(var(--color-accent) 1.5px, transparent 1.5px);
    background-size: 26px 26px;
    mask-image: radial-gradient(closest-side, black 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(closest-side, black 0%, transparent 70%);
  }

  .hero-glow {
    position: absolute;
    top: -6rem;
    right: -6rem;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 22%, transparent),
      transparent 65%
    );
    animation: glow-drift var(--duration-16000) var(--ease-in-out) infinite alternate;
  }

  @keyframes glow-drift {
    from { transform: translate(0, 0) scale(1); opacity: 0.9; }
    to { transform: translate(-26px, 18px) scale(1.16); opacity: 1; }
  }

  /* Élément décoratif flottant discret */
  .hero-float {
    position: absolute;
    z-index: 0;
    right: 6%;
    bottom: var(--space-16);
    width: 60px;
    height: 60px;
    border-radius: 18px;
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    border: 1.5px solid color-mix(in srgb, var(--color-accent) 32%, transparent);
    animation: float-slow 11s var(--ease-in-out) infinite;
  }

  @keyframes float-slow {
    0%, 100% { transform: rotate(45deg) translate(0, 0); }
    50% { transform: rotate(45deg) translate(10px, -18px); }
  }

  .hero-badge {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    background-color: var(--color-accent-light);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-8);
    border: 1px solid var(--color-border);
    animation: hero-el-in var(--duration-slow) var(--ease-out-quart) both;
    animation-delay: 40ms;
  }

  @keyframes hero-el-in {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  .hero-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-success);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-success) 60%, transparent);
    animation: pulse-dot 2s infinite;
  }

  @keyframes pulse-dot {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-success) 55%, transparent); }
    70% { box-shadow: 0 0 0 7px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .hero-title {
    position: relative;
    z-index: 1;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    letter-spacing: -0.02em;
    line-height: 1.08;
    margin-bottom: var(--space-6);
    max-width: 18ch;
  }

  /* Cascade de mots (activée par le script, jamais sans JS) */
  .hero-title.is-animating .hero-word {
    opacity: 0;
    animation: hero-word-in var(--duration-slow) var(--ease-out-quart) forwards;
    animation-delay: calc(120ms + var(--i) * var(--stagger-step));
  }

  @keyframes hero-word-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  .hero-title :global(.hero-accent) {
    color: var(--color-accent);
    background: var(--color-accent-light);
    border-radius: var(--radius-sm);
    padding: 0 0.12em;
    margin: 0 -0.02em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .hero-subtitle {
    position: relative;
    z-index: 1;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 620px;
    margin-bottom: var(--space-12);
    animation: hero-el-in var(--duration-slow) var(--ease-out-quart) both;
    animation-delay: 340ms;
  }

  .hero-actions {
    position: relative;
    z-index: 1;
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-12);
    animation: hero-el-in var(--duration-slow) var(--ease-out-quart) both;
    animation-delay: 440ms;
  }

  .hero-proofs {
    position: relative;
    z-index: 1;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    padding: 0;
    animation: hero-el-in var(--duration-slow) var(--ease-out-quart) both;
    animation-delay: 540ms;
  }

  .hero-proofs li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .hero-proofs svg {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .hero-float {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-float {
      display: none;
    }

    .hero-title.is-animating .hero-word {
      opacity: 1;
      animation: none;
    }
  }
</style>